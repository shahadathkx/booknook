# BookNook Environment Configuration
# API Service Endpoint (Express Server Backend)
NEXT_PUBLIC_API_URL="http://localhost:7000"

# Application URL (Next.js Client / Frontend)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Application Identity & Circulation
NEXT_PUBLIC_APP_NAME="BookNook"
NEXT_PUBLIC_LIBRARY_BRANCH="The Forest Hearth"
NEXT_PUBLIC_DEFAULT_LOAN_DAYS="14"
NEXT_PUBLIC_LIBRARY_MOTTO="Add, borrow, and return timeless stories."

# Database Connection (MongoDB)
MONGODB_URI="mongodb://localhost:27017/booknook"

# BetterAuth Server Settings
BETTER_AUTH_SECRET="your-better-auth-secret-key-at-least-32-chars-long"
BETTER_AUTH_URL="http://localhost:3000"
TRUSTED_ORIGINS="http://localhost:3000,http://localhost:7000"

# Google Social OAuth Provider
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ImgBB Image Upload API Key
NEXT_PUBLIC_IMGBB_KEY="your-imgbb-api-key"
